# ==============================================================================
# BANDHSETU FRONTEND ENVIRONMENT CONFIGURATION (TEMPLATE)
# ==============================================================================
# Copy this file to .env for local development.
# In Vercel, set these environment variables in Project Settings -> Environment Variables.
# IMPORTANT: Never include SUPABASE_SERVICE_ROLE_KEY or private secrets in frontend!
# ==============================================================================

# Backend API Base URL
# Local development: http://localhost:8000/api/v1
# Cloud / Render: https://bandhsetu-api.onrender.com/api/v1
VITE_API_BASE_URL=https://bandhsetu-api.onrender.com/api/v1

# Supabase Public Client Configuration
VITE_SUPABASE_URL=https://your-supabase-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-supabase-anon-public-key

# App Environment: 'development', 'staging', or 'production'
VITE_APP_ENV=production
