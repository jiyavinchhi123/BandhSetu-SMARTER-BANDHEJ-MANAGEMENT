# Environment configuration
ENVIRONMENT=development
DEBUG=True
PROJECT_NAME="Bandhej Worker and Business Management API"
VERSION="1.0.0"
API_V1_STR="/api/v1"

# CORS configuration (comma-separated or JSON list)
BACKEND_CORS_ORIGINS=["http://localhost:5173","http://127.0.0.1:5173","http://localhost:3000"]

# Database configuration (Supabase PostgreSQL connection string)
# Format: postgresql+psycopg://<user>:<password>@<host>:<port>/<database>
DATABASE_URL=postgresql+psycopg://postgres:postgres@localhost:5432/postgres

# Supabase Authentication & Service
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_KEY=your-supabase-anon-key
SUPABASE_JWT_SECRET=your-supabase-jwt-secret

# Regional & Business Settings
DEFAULT_CURRENCY=INR
TIMEZONE=Asia/Kolkata

