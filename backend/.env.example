# Environment configuration
ENVIRONMENT=development
DEBUG=True
PROJECT_NAME="Bandhej Worker and Business Management API"
VERSION="1.0.0"
API_V1_STR="/api/v1"

# CORS configuration (comma-separated or JSON list)
BACKEND_CORS_ORIGINS=["http://localhost:5173","http://127.0.0.1:5173","http://localhost:3000"]

# Database configuration (Supabase PostgreSQL connection string)
DATABASE_URL=sqlite:///./bandhej_dev.db

# JWT & Security
JWT_SECRET_KEY=bandhej-super-secret-key-change-in-production-min32chars
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=840

# Supabase Authentication & Service
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_KEY=your-supabase-anon-key
SUPABASE_JWT_SECRET=your-supabase-jwt-secret

# Regional & Business Settings
DEFAULT_CURRENCY=INR
TIMEZONE=Asia/Kolkata

# Manager Access Window (Asia/Kolkata IST)
DEFAULT_MANAGER_START_TIME=09:00
DEFAULT_MANAGER_END_TIME=20:00
