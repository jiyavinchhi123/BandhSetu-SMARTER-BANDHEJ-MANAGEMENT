# ==============================================================================
# BANDHSETU BACKEND ENVIRONMENT CONFIGURATION (TEMPLATE)
# ==============================================================================
# Copy this file to .env and replace placeholder values with your credentials.
# NEVER commit the actual .env file with secrets to version control.
# ==============================================================================

# Application Environment: 'development', 'staging', or 'production'
APP_ENV=production
DEBUG=False
PROJECT_NAME="BandhSetu — Smarter Bandhej Management API"
VERSION="1.0.0"
API_V1_STR="/api/v1"

# Database Connection URL:
# Local development: sqlite:///./bandhej_dev.db
# Cloud / Supabase: postgresql://postgres.[project-ref]:[db-password]@aws-0-ap-south-1.pooler.supabase.com:6543/postgres
DATABASE_URL=postgresql://postgres.placeholder:your-password@aws-0-ap-south-1.pooler.supabase.com:6543/postgres

# Allowed CORS Origins (comma-separated or JSON array)
# Add your production Vercel frontend domain:
CORS_ORIGINS=["https://bandhsetu.vercel.app","http://localhost:5173","http://127.0.0.1:5173"]

# JWT Session Authentication Secret (Generate with: openssl rand -hex 32)
JWT_SECRET_KEY=generate-a-strong-32-character-secret-key-for-production
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=840

# Supabase Cloud Project Credentials
SUPABASE_URL=https://your-project-id.supabase.co
SUPABASE_ANON_KEY=your-supabase-anon-public-key
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-secret-key
SUPABASE_JWT_SECRET=your-supabase-jwt-secret-from-api-settings

# Business Regional Localization
DEFAULT_CURRENCY=INR
TIMEZONE=Asia/Kolkata

# Manager Access Window in IST (24-hour HH:MM format)
DEFAULT_MANAGER_START_TIME=09:00
DEFAULT_MANAGER_END_TIME=20:00
